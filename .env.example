# Pokémon Bot — environment variables.
# Copy to `.env` and fill in values. Loaded by pokemon_bot.config via python-dotenv.
#
# Migration (2026-05-26): the chat-completion path was switched from OpenAI to
# Anthropic Claude. ANTHROPIC_API_KEY is now the only required key for the chat
# pipeline; OPENAI_API_KEY and AI_PROVIDER are no longer used.

# Anthropic — used by EVERY chat-completion call (planner, validator,
# executor synthesis, query refinement, placeholder resolver) plus the
# final-answer streaming step.
ANTHROPIC_API_KEY=

# Kimi (Moonshot) — used by the kimi-k2 extraction step inside the executor.
# OpenAI-compatible API; base URL points at Moonshot. The kimi key is
# optional in the sense that the chat pipeline still loads without it, but
# any extraction call will fail at runtime if it isn't set.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Optional: override default models.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
KIMI_MODEL=moonshot-v1-32k

# ─────────────────────────────────────────────────────────────────────────
# ElasticDash SDK (optional)
# ─────────────────────────────────────────────────────────────────────────
# When ELASTICDASH_SERVER_URL is set, the REPL calls `init_observability`
# at boot and wraps every chat turn in `start_trace("pokemon_chat") /
# end_trace()`. Inside that trace:
#   • every tool call registered via `@ed_tool` (the 7 pokemon tools)
#   • every LLM HTTP call (Anthropic + Moonshot, picked up by the SDK's
#     httpx interceptor)
# is recorded as a WorkflowEvent and pushed to the backend.
# When ELASTICDASH_SERVER_URL is unset, the REPL skips init entirely and
# every wrap_tool / wrap_ai surface becomes a pure passthrough.
#
# The MCP server (queried by Claude Code via `mcp__elasticdash-mcp__*`
# tools for trace search and rerun) is configured separately in .mcp.json.
# ─────────────────────────────────────────────────────────────────────────
# ELASTICDASH_SERVER_URL=https://server.elasticdash.com
# ELASTICDASH_API_KEY=
# ELASTICDASH_DEBUG=0
