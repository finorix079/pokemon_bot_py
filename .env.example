# Pokémon Bot — environment variables.
# Copy to `.env` and fill in values. Loaded by pokemon_bot.config via python-dotenv.
#
# Migration (2026-05-26): the chat-completion path was switched from OpenAI to
# Anthropic Claude. ANTHROPIC_API_KEY is now the only required key for the chat
# pipeline; OPENAI_API_KEY and AI_PROVIDER are no longer used.

# Anthropic — used by EVERY chat-completion call (planner, validator,
# executor synthesis, query refinement, placeholder resolver) plus the
# final-answer streaming step.
ANTHROPIC_API_KEY=

# Kimi (Moonshot) — used by the kimi-k2 extraction step inside the executor.
# OpenAI-compatible API; base URL points at Moonshot. The kimi key is
# optional in the sense that the chat pipeline still loads without it, but
# any extraction call will fail at runtime if it isn't set.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Optional: override default models.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
KIMI_MODEL=moonshot-v1-32k

# ─────────────────────────────────────────────────────────────────────────
# ElasticDash observability (optional)
# ─────────────────────────────────────────────────────────────────────────
# When these keys are set, every tool call (wrap_tool) and every LLM call
# (wrap_ai) is recorded as a span / generation in the ElasticDash dashboard.
# When unset, the SDK logs a single "Client will be disabled" warning at
# startup and the wrap_tool / wrap_ai decorators no-op cleanly.
#
# ElasticDash MCP server (queried by Claude Code for trace search):
# configured in .mcp.json — runs the Node TS server at
# /Users/jiangjiahao/Documents/GitHub/ElasticDash-MCP/mcp-server/server.ts
# ─────────────────────────────────────────────────────────────────────────
# ELASTICDASH_PUBLIC_KEY=
# ELASTICDASH_SECRET_KEY=
# ELASTICDASH_BASE_URL=
# ELASTICDASH_HOST=
# ELASTICDASH_DEBUG=false
# ELASTICDASH_TRACING_ENABLED=true

# ── ElasticDash test framework (`elasticdash-test` Python package) ──
# Used by the `ai_test` pytest helpers; the chat pipeline itself doesn't
# read these but the test framework does.
# ELASTICDASH_API_URL=
# ELASTICDASH_API_KEY=
# ELASTICDASH_CAPTURE_TRACE=0
# ELASTICDASH_ACCEPT_RERUNS=0
